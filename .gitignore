# ── 빌드 산출물 (커밋하지 않음) ──
/dist/
/build/
*.spec

# ── 파이썬 캐시 ──
__pycache__/
*.pyc
*.pyo

# ── 로그 / 임시 ──
*.log
*.tmp

# ── 데이터 파일 (실제 주소록/산출물은 절대 커밋 금지) ──
*.xlsx
*.xls
*.xlsm
*.csv
*.pia
~$*

# ── OS/IDE ──
.DS_Store
Thumbs.db
.vscode/
.idea/

